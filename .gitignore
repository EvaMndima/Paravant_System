# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# Anchored to the repository root with a leading slash. Without it, git matches
# these names at ANY depth -- `lib/` also matched `frontend/src/lib/`, so
# utils.ts and animations.ts were never committed and the frontend could not be
# built from a fresh clone. Local checkouts hid it: the files were on disk.
/build/
/develop-eggs/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Build output, listed explicitly rather than relying on a bare `dist/` that
# would match anywhere.
/dist/
frontend/dist/
frontend/.vite/

# Virtual environments. Anchored for the same reason as above; an unanchored
# `env/` would match any directory named env anywhere in the tree.
.venv/
venv/
/ENV/
/env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*.sublime-*

# Environment
.env
.env.local

# Database
*.db
*.sqlite
*.sqlite3

# Logs
logs/*.log
*.log

# Data
data/*.csv
data/*.json
data/*.db

# Testing
.coverage
htmlcov/
.pytest_cache/
.tox/
.mypy_cache/
.ruff_cache/

# Build
*.manifest
*.spec

# Secrets (never commit!)
*_secret*
*_key*
credentials*

# Frontend build cache
frontend/.vite/
node_modules/

# OS
.DS_Store
Thumbs.db

# Docker build artifacts (not .dockerignore itself — Railway needs it)
*.dockerignore.bak

# AI agent skills (local tool configurations, not project code)
.agent/skills/
.claude/skills/

# Research layer transient artifacts (regenerable; not committed)
research/.cache/
docs/research/regime_dsr/_*.log
# Forward-collected liquidation events (accrues over time; DEC-2026-06-04-021)
research/data/liquidations/

# Local AI-assistant tooling.
# .claude/skills and .agent/skills are clones of a third-party skills
# library (sickn33/antigravity-awesome-skills), not part of this project.
# They were previously tracked as gitlinks with no .gitmodules entry,
# which made a fresh clone produce two empty directories.
.claude/skills/
.agent/skills/

# Per-machine assistant configuration. These were tracked until 2026-08-20 and
# should not have been: they are local tooling, not project artifacts, and
# publishing them leaks the developer's filesystem layout.
#
# .claude/mcp_config.json in particular carried an interpreter path under a
# different Windows account (C:\Users\Dell\anaconda3) and pointed two MCP
# servers -- PYTHONPATH and the filesystem server root -- at an unrelated
# predecessor project, D:\Eva\Projects\MultiAgentTradingSystem. No credentials:
# the ${GITHUB_TOKEN}-style entries are interpolation placeholders. It reads as
# config that was copied between projects and never reviewed, which is exactly
# what it was.
#
# What IS tracked under .claude/ and .agent/ is deliberate and belongs to the
# project: DECISIONS.md, CLAUDE.md / SYSTEM.md, and rules/.
.claude/mcp_config.json
.claude/settings.local.json
.agent/mcp.json

# Design source PDFs (21.8 MB). Kept on disk as design references but not
# tracked -- they are exported artifacts, not source, and the rendered
# screenshots under docs/design/screenshots/ serve the same purpose at
# 1/6th the size.
docs/design/pdf/
