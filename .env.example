# .env.example - Copy to .env and fill in values

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=sqlite:///data/trading.db

# =============================================================================
# BINANCE (Use testnet for development!)
# =============================================================================
BINANCE_API_KEY=your_testnet_api_key
BINANCE_SECRET_KEY=your_testnet_secret_key
BINANCE_TESTNET=true

# =============================================================================
# TELEGRAM ALERTS
# =============================================================================
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# =============================================================================
# API AUTHENTICATION
# =============================================================================
# Shared secret required in the X-API-Key header on every state-mutating
# request (POST/PUT/PATCH/DELETE): placing orders, toggling the kill switch,
# starting and stopping the system. Read endpoints are NOT gated.
# See SECURITY.md and DEC-2026-08-14-001.
#
# Minimum 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Left commented out deliberately. With ENVIRONMENT=development and no key set,
# the gate is disabled so the quickstart runs -- startup logs api_auth_disabled.
# With ENVIRONMENT set to anything else, a missing key ABORTS STARTUP.
#
# PARAVANT_API_KEY=replace_me_with_a_generated_32_char_minimum_secret

# =============================================================================
# API RATE LIMITING
# =============================================================================
# Caps how fast state-mutating requests (POST/PUT/PATCH/DELETE) are accepted.
# Read endpoints are NOT limited. See SECURITY.md and DEC-2026-08-14-003.
#
# Two independent buckets:
#   API_RATE_LIMIT_PER_MINUTE        per client, keyed on X-Forwarded-For.
#                                    Fairness only -- that header is set by the
#                                    client and is therefore spoofable.
#   API_RATE_LIMIT_GLOBAL_PER_MINUTE across all clients. Trusts no client value,
#                                    so it cannot be evaded. This is the real cap.
#
# Defaults (30 and 120) are generous on purpose: a human clicking buttons never
# reaches them, a runaway script reaches them in seconds. Set either to 0 to
# disable that bucket. An unparseable value falls back to the default.
#
# API_RATE_LIMIT_PER_MINUTE=30
# API_RATE_LIMIT_GLOBAL_PER_MINUTE=120

# =============================================================================
# SYSTEM
# =============================================================================
LOG_LEVEL=INFO
TRADING_MODE=paper
ENVIRONMENT=development

# =============================================================================
# LIVE TRADING KILL SWITCH
# =============================================================================
# Left commented out deliberately. scripts/run_all.py only spawns the live
# trading loop when this is explicitly truthy (true/1/yes/on) -- see
# DEC-2026-05-27-001. Paper trading always runs; live is opt-in.
#
# Uncommenting this places REAL ORDERS with REAL MONEY. No strategy in this
# repository has passed its own validation gates. Read SECURITY.md first.
#
# LIVE_TRADING_ENABLED=false

# =============================================================================
# OPTIONAL - Override config file settings
# =============================================================================
# MAX_POSITION_SIZE_PCT=10.0
# DAILY_LOSS_LIMIT_PCT=5.0
